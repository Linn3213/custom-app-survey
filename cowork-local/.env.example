# Copy to .env and fill in. Never commit your real .env.

# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: a shared secret the web UI must present. If left blank, a random
# token is generated at startup and printed to the console.
COWORK_TOKEN=

# Optional: colon-separated list of directories the agent may touch.
# Defaults to ~/CoworkLocal (created on first run). Everything the agent
# reads, writes, or runs is confined to these roots.
COWORK_ROOTS=

# Optional model + behaviour tuning.
COWORK_MODEL=claude-opus-4-8
COWORK_EFFORT=high
COWORK_MAX_TOKENS=32000
COWORK_SHELL_TIMEOUT=120

# If "1", the agent runs every action without asking (DANGEROUS). Default 0.
COWORK_AUTO_APPROVE=0
